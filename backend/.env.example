# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/hermes_dev
MONGO_DB_NAME=hermes_dev

# Auth & Security
JWT_SECRET=change_me
REFRESH_TOKEN_SECRET=change_me_as_well
TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Simulation & Services
SIMULATION_INTERVAL_MS=30000
DATA_GEN_INTERVAL_MS=2000
DATA_GEN_MACHINE_REFRESH_MS=5000
DATA_GEN_TEMP_DELTA=0.3
DATA_GEN_TORQUE_DELTA=3
DATA_GEN_ENERGY_DELTA=0.12
DATA_GEN_RUNNING_SIGNAL_DROP_PROB=0.01
DATA_GEN_RUNNING_SIGNAL_RECOVERY_PROB=0.9
DATA_GEN_IDLE_SIGNAL_DROP_PROB=0.2
DATA_GEN_IDLE_SIGNAL_RISE_PROB=0.1
DATA_GEN_TRANSITION_MS=10000
AI_ANALYSIS_MODE=rules
LOG_LEVEL=info
JOB_SIM_INTERVAL_MS=2000
JOB_SIM_DEFECT_RATE=0.05
JOB_SIM_IDLE_PROBABILITY=0.15

# Seed Script
SEED_ADMIN_EMAIL=admin@hermes.local
