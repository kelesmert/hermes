# Server
# PORT: Backend HTTP portu.
PORT=5000
# NODE_ENV: Ortam modu (development/production); bazı feature’lar prod’da otomatik kapanır.
NODE_ENV=development
# CLIENT_URL: CORS için izinli frontend origin’i.
CLIENT_URL=http://localhost:5173

# Database
# MONGO_URI: MongoDB bağlantı adresi.
MONGO_URI=mongodb://localhost:27017/hermes_dev
# MONGO_DB_NAME: Kullanılacak veritabanı adı.
MONGO_DB_NAME=hermes_dev

# Auth & Security
# JWT_SECRET: Access token imzalama anahtarı.
JWT_SECRET=change_me
# REFRESH_TOKEN_SECRET: Refresh token imzalama anahtarı.
REFRESH_TOKEN_SECRET=change_me_as_well
# TOKEN_EXPIRES_IN: Access token süresi (örn 15m).
TOKEN_EXPIRES_IN=15m
# REFRESH_TOKEN_EXPIRES_IN: Refresh token süresi (örn 7d).
REFRESH_TOKEN_EXPIRES_IN=7d

# Simulation & Services
# SIMULATION_INTERVAL_MS: Simülasyon listesi/poll gibi arka plan interval’ları için genel ayar.
SIMULATION_INTERVAL_MS=30000
# ENABLE_SIMULATION_CONTROL: /simulations üzerinden start/stop/log kontrolünü açar (prod’da varsayılan kapalı).
ENABLE_SIMULATION_CONTROL=true
# SIMULATION_LOG_MAX_LINES: Simülasyon log buffer’ında tutulacak maksimum satır sayısı.
SIMULATION_LOG_MAX_LINES=2000
# SIMULATION_STOP_TIMEOUT_MS: Stop isteğinde SIGTERM sonrası bekleme; aşarsa SIGKILL uygulanır.
SIMULATION_STOP_TIMEOUT_MS=8000
# DATA_GEN_INTERVAL_MS: data-gen telemetry yazma aralığı.
DATA_GEN_INTERVAL_MS=2000
# DATA_GEN_MACHINE_REFRESH_MS: data-gen aktif makine/job bilgisini DB’den yenileme aralığı.
DATA_GEN_MACHINE_REFRESH_MS=5000
# DATA_GEN_PLANNED_STOPPED_MODE: Planlı duruş açıkken data-gen signal/metrikleri 0’a kilitler.
DATA_GEN_PLANNED_STOPPED_MODE=true
# DATA_GEN_TEMP_DELTA: data-gen sıcaklık oynaklığı.
DATA_GEN_TEMP_DELTA=0.3
# DATA_GEN_TORQUE_DELTA: data-gen tork oynaklığı.
DATA_GEN_TORQUE_DELTA=3
# DATA_GEN_ENERGY_DELTA: data-gen enerji oynaklığı.
DATA_GEN_ENERGY_DELTA=0.12
# DATA_GEN_RUNNING_SIGNAL_DROP_PROB: running iken 1→0 düşüş olasılığı.
DATA_GEN_RUNNING_SIGNAL_DROP_PROB=0.01
# DATA_GEN_RUNNING_SIGNAL_RECOVERY_PROB: running iken 0→1 toparlama olasılığı.
DATA_GEN_RUNNING_SIGNAL_RECOVERY_PROB=0.9
# DATA_GEN_IDLE_SIGNAL_DROP_PROB: idle iken 1→0 düşüş olasılığı.
DATA_GEN_IDLE_SIGNAL_DROP_PROB=0.2
# DATA_GEN_IDLE_SIGNAL_RISE_PROB: idle iken 0→1 yükseliş olasılığı.
DATA_GEN_IDLE_SIGNAL_RISE_PROB=0.1
# DATA_GEN_TRANSITION_MS: Profil geçişlerinde metriklerin ramp-up/down süresi.
DATA_GEN_TRANSITION_MS=10000
# AI_ANALYSIS_MODE: AI analiz modunu seçer (örn rules).
AI_ANALYSIS_MODE=rules
# LOG_LEVEL: Uygulama log seviyesi.
LOG_LEVEL=info
# OEE_PROCESSOR_TELEMETRY_SOURCE: OEE processor hangi telemetry kaynağını işleyecek (shift-sim|all).
OEE_PROCESSOR_TELEMETRY_SOURCE=shift-sim
# JOB_SIM_INTERVAL_MS: job-sim üretim döngüsü tick aralığı.
JOB_SIM_INTERVAL_MS=2000
# JOB_SIM_DEFECT_RATE: job-sim için hata oranı (shift-sim koşularında 0’a çekilebilir).
JOB_SIM_DEFECT_RATE=0.05
# JOB_SIM_IDLE_PROBABILITY: job-sim üretim yazarken “skip” olasılığı (shift-sim koşularında 0’a çekilebilir).
JOB_SIM_IDLE_PROBABILITY=0.15
# JOB_SIM_MAX_TELEMETRY_RECORDS: job-sim’in bir tick’te okuyacağı maksimum telemetry kaydı.
JOB_SIM_MAX_TELEMETRY_RECORDS=5000
# JOB_SIM_PART_MB_001_CYCLE_TIME_SECONDS: PART-MB-001 için ideal cycle time override (testte yavaşlatmak için).
JOB_SIM_PART_MB_001_CYCLE_TIME_SECONDS=600

# Shift Simulator (Accelerated shift telemetry)
# Not: data-gen ile aynı anda çalıştırmayın.
# SHIFT_SIM_EPOCH_DATE: Shift sim sanal takvim başlangıç günü (YYYY-MM-DD).
SHIFT_SIM_EPOCH_DATE=2025-01-01
# SHIFT_SIM_SHIFT_START: Vardiya başlangıç saati (Europe/Istanbul).
SHIFT_SIM_SHIFT_START=07:00
# SHIFT_SIM_SHIFT_END: Vardiya bitiş saati (Europe/Istanbul).
SHIFT_SIM_SHIFT_END=18:00
# SHIFT_SIM_REAL_DURATION_SECONDS: Vardiya verisini kaç saniyede üreteceğini belirler (hızlandırma).
SHIFT_SIM_REAL_DURATION_SECONDS=180
# SHIFT_SIM_TICK_MS: shift-sim loop tick’i (yük/hız dengesi).
SHIFT_SIM_TICK_MS=250
# SHIFT_SIM_INTERVAL_MS: shift-sim telemetry sample aralığı (timestamp adımı).
SHIFT_SIM_INTERVAL_MS=2000
# SHIFT_SIM_MACHINE_REFRESH_MS: shift-sim makineleri/job durumunu DB’den yenileme aralığı.
SHIFT_SIM_MACHINE_REFRESH_MS=5000
# SHIFT_SIM_CLEAR_BEFORE_START: Başlamadan önce shift-sim verilerini ve clock state’i resetler.
SHIFT_SIM_CLEAR_BEFORE_START=false
# SHIFT_SIM_PLANNED_STOPPED_MODE: Planlı duruş açıkken shift-sim signal/metrikleri 0’a kilitler.
SHIFT_SIM_PLANNED_STOPPED_MODE=true
# SHIFT_SIM_TRANSITION_MS: Metrik profil geçiş smoothing süresi.
SHIFT_SIM_TRANSITION_MS=10000
# SHIFT_SIM_WAIT_FOR_PROCESSING_MS: Koşu bitince shift_end uygulamadan önce telemetry’nin işlenmesini bekleme süresi.
SHIFT_SIM_WAIT_FOR_PROCESSING_MS=60000

# Seed Script
# SEED_ADMIN_*: Seed sırasında admin hesabı oluşturma/güncelleme bilgileri.
# SEED_ADMIN_EMAIL: Seed sırasında admin e-posta adresi.
SEED_ADMIN_EMAIL=admin@hermes.local
# SEED_ADMIN_USERNAME: Seed sırasında admin kullanıcı adı.
SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD: Seed sırasında admin şifresi.
SEED_ADMIN_PASSWORD=ChangeMe123!
# SEED_ADMIN_FIRST_NAME: Seed sırasında admin ad alanı.
SEED_ADMIN_FIRST_NAME=Hermes
# SEED_ADMIN_LAST_NAME: Seed sırasında admin soyad alanı.
SEED_ADMIN_LAST_NAME=Admin

# SEED_SYS_*: Seed sırasında sys/test hesabı oluşturma/güncelleme bilgileri.
# SEED_SYS_EMAIL: Seed sırasında sys/test e-posta adresi.
SEED_SYS_EMAIL=sys@hermes.local
# SEED_SYS_USERNAME: Seed sırasında sys/test kullanıcı adı.
SEED_SYS_USERNAME=sys
# SEED_SYS_PASSWORD: Seed sırasında sys/test şifresi.
SEED_SYS_PASSWORD=sys
# SEED_SYS_FIRST_NAME: Seed sırasında sys/test ad alanı.
SEED_SYS_FIRST_NAME=System
# SEED_SYS_LAST_NAME: Seed sırasında sys/test soyad alanı.
SEED_SYS_LAST_NAME=Observer

# SEED_SUPERVISOR_*: Seed sırasında supervisor hesabı oluşturma/güncelleme bilgileri.
# SEED_SUPERVISOR_EMAIL: Seed sırasında supervisor e-posta adresi.
SEED_SUPERVISOR_EMAIL=supervisor@hermes.local
# SEED_SUPERVISOR_USERNAME: Seed sırasında supervisor kullanıcı adı.
SEED_SUPERVISOR_USERNAME=supervisor
# SEED_SUPERVISOR_PASSWORD: Seed sırasında supervisor şifresi.
SEED_SUPERVISOR_PASSWORD=Supervisor123!
# SEED_SUPERVISOR_FIRST_NAME: Seed sırasında supervisor ad alanı.
SEED_SUPERVISOR_FIRST_NAME=Line
# SEED_SUPERVISOR_LAST_NAME: Seed sırasında supervisor soyad alanı.
SEED_SUPERVISOR_LAST_NAME=Supervisor
